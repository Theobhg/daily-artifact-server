# Nome exibido no Swagger e no OpenAPI
APP_NAME=Daily Artifact API

# Versao da API exposta no OpenAPI
APP_VERSION=1.0.0

# String de conexao do SQLite (arquivo criado automaticamente)
DATABASE_URL=sqlite:///./daily_artifact.db

# Origens permitidas pelo CORS, separadas por virgula.
# "*" e necessario porque o frontend roda via file:// (Origin: null).
CORS_ORIGINS=*
